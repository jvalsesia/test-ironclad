  "query": "SELECT id, title, description, status, priority, due_date, created_at, updated_at FROM tasks WHERE ($1::text[] IS NULL OR status = ANY($1)) AND ($2::text[] IS NULL OR priority = ANY($2)) ORDER BY CASE priority WHEN 'low' THEN 1 WHEN 'medium' THEN 2 ELSE 3 END ASC, id ASC LIMIT $3 OFFSET $4",
