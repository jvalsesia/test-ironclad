  "query": "UPDATE tasks SET title = COALESCE($2, title), description = CASE WHEN $3 THEN $4 ELSE description END, status = COALESCE($5, status), priority = COALESCE($6, priority), due_date = CASE WHEN $7 THEN $8 ELSE due_date END, updated_at = now() WHERE id = $1 RETURNING id, title, description, status, priority, due_date, created_at, updated_at",
