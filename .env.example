# Task API configuration. Copy to `.env` for local development.
# Process environment variables take precedence over values in `.env`.

# Required. PostgreSQL 16 connection string (no default).
DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks

# Address to bind. HOST must be an IP address.            (default 0.0.0.0)
HOST=0.0.0.0
# TCP port, 1-65535.                                      (default 8080)
PORT=8080
# Maximum pooled connections, 1-100.                      (default 10)
DATABASE_MAX_CONNECTIONS=10
# Seconds to wait for a pooled connection, 1-300.         (default 5)
DATABASE_ACQUIRE_TIMEOUT_SECS=5
# Mounts the /__test/* diagnostic routes. true | false.   (default false)
# Keep false outside of automated tests.
ENABLE_TEST_ROUTES=false

# Log output format. json | pretty.                       (default json)
# json: one JSON object per line. pretty: human-readable single lines.
LOG_FORMAT=json
# Log filter: a level (error, warn, info, debug, trace) or an
# EnvFilter directive such as "info,sqlx=warn".           (default info)
LOG_LEVEL=info
